{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Streamlit chatbot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "streamlit", "run", "app.py", "--server.address", "127.0.0.1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Check OpenRouter key",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/check_openrouter.py"],
      "problemMatcher": []
    },
    {
      "label": "Send free OpenRouter test message",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/check_openrouter.py", "--chat"],
      "problemMatcher": []
    }
  ]
}
